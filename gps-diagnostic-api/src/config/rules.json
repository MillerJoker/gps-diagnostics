{
  "reglas_diagnostico": [
    {
      "id": "ERR_IGNICION",
      "nombre": "Inconsistencia de Ignición",
      "condicion": "Number(row['Velocidad'] || 0) > 5 && row['Motor'] === 'Apagado'",
      "sugerencia": "Revisar cable de ignición (ACC).",
      "severidad": "Alta",
      "exclusivoCandado": false
    },
    {
      "id": "ERR_BATERIA_DESCONECTADA",
      "nombre": "Corte de Energía Principal",
      "condicion": "row['Bateria Vehiculo'] === '-' || !row['Bateria Vehiculo']",
      "sugerencia": "Revisar conexión a la batería del vehículo y porta-fusibles.",
      "severidad": "Crítica",
      "exclusivoCandado": false
    },
    {
      "id": "ERR_BATERIA_BAJA",
      "nombre": "Batería Interna Agotada",
      "condicion": "String(row['Estado'] || '').includes('Bateria Baja')",
      "sugerencia": "Reemplazar batería de respaldo del módulo GPS.",
      "severidad": "Media",
      "exclusivoCandado": false
    },
    {
      "id": "ERR_PERDIDA_SENAL",
      "nombre": "Pérdida de Transmisión (Puntos Guardados)",
      "condicion": "row['GPS'] === 'Guardado'",
      "sugerencia": "Revisar SIM card o ubicación de la antena.",
      "severidad": "Baja",
      "exclusivoCandado": false
    },
    {
      "id": "ERR_CANDADO_CARGANDO",
      "nombre": "Candado en Proceso de Carga",
      "condicion": "Number(row['Voltaje_Parseado'] || 0) > 13.5",
      "sugerencia": "El candado se encuentra conectado a la fuente de alimentación para carga.",
      "severidad": "Baja",
      "exclusivoCandado": true
    },
    {
      "id": "ERR_CANDADO_VOLTAJE_BAJO",
      "nombre": "Voltaje Óptimo de Candado Deficiente",
      "condicion": "Number(row['Voltaje_Parseado'] || 0) > 0 && Number(row['Voltaje_Parseado'] || 0) < 12.6",
      "sugerencia": "Candado requiriendo carga urgente (Voltaje menor al rango óptimo de 12.6V - 13.5V).",
      "severidad": "Alta",
      "exclusivoCandado": true
    },
    {
      "id": "ERR_TEMPERATURA_EXTREMA",
      "nombre": "Temperatura Fuera de Rango (Candado/Dispositivo)",
      "condicion": "Number(row['Temperatura'] || 0) < -10 || Number(row['Temperatura'] || 0) > 60",
      "sugerencia": "Revisar entorno térmico del dispositivo (Temperatura extremadamente alta o baja).",
      "severidad": "Crítica",
      "exclusivoCandado": false
    }
  ]
}